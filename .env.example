# ==================================
# LLM Knowledge Extractor Configuration
# ==================================

# Required: Anthropic API Configuration
# Get your API key from: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-api03-your-anthropic-api-key-here

# Database Configuration
# PostgreSQL connection string
# Format: postgresql://username:password@host:port/database_name
DATABASE_URL=postgresql://username:password@localhost:5432/knowledge_extractor

# For Docker Compose (uses service name as host)
# DATABASE_URL=postgresql://username:password@postgres:5432/knowledge_extractor

# API Configuration
# Backend API base URL for frontend requests
API_BASE_URL=http://localhost:8000




